# ==============================================================================
# DataStraw Smart Roster Management System - Global Git Ignore
# Covers root, frontend (React + Vite), and backend (Node.js + Express)
# ==============================================================================

# ------------------------------------------------------------------------------
# Dependencies
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
frontend/node_modules/
backend/node_modules/
.pnp/
.pnp.js

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# (Explicitly preserve .env.example files across root, frontend, and backend)
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

frontend/.env
frontend/.env.*
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
!frontend/.env.example

backend/.env
backend/.env.*
backend/.env.local
backend/.env.development.local
backend/.env.test.local
backend/.env.production.local
!backend/.env.example

# ------------------------------------------------------------------------------
# Production Build & Generated Output
# ------------------------------------------------------------------------------
dist/
dist-ssr/
frontend/dist/
backend/dist/
build/
out/
.next/
.nuxt/
.vuepress/dist/

# ------------------------------------------------------------------------------
# Test Coverage & Verification Artifacts
# ------------------------------------------------------------------------------
coverage/
*.lcov
.nyc_output/

# ------------------------------------------------------------------------------
# Cache Directories
# ------------------------------------------------------------------------------
.cache/
.parcel-cache/
.turbo/
.eslintcache/
.stylelintcache/
*.tsbuildinfo
.npm/
.yarn/cache/
.vite/

# ------------------------------------------------------------------------------
# Logs & Process Dumps
# ------------------------------------------------------------------------------
*.log
*.log.*
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# Temporary Files, Dumps & Local Backups
# ------------------------------------------------------------------------------
*.tmp
*.temp
*.swp
*.swo
*~
backups/
backend/backups/
*.bak
*.backup
*.dump
backup_before_reset_*.json
datastraw_backup_*.json

# ------------------------------------------------------------------------------
# OS-Generated Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------------------------------------------
# IDE & Editor Configurations
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
